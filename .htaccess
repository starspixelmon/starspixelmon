# Stars Pixelmon · configuração do servidor (Apache/LiteSpeed da Hostinger)

# Endereço oficial: https://starspixelmon.com.br (sem www).
# Também redireciona os domínios extras do cliente (aliases na Hostinger), com e sem www.
# A lista é explícita de propósito: subdomínios como launcher.starspixelmon.com.br não podem ser redirecionados.
RewriteEngine On
# 1. www e domínios extras -> endereço oficial (um único salto)
RewriteCond %{HTTP_HOST} ^www\.starspixelmon\.com\.br$ [NC,OR]
RewriteCond %{HTTP_HOST} ^(www\.)?(starspixelmon\.com|starscobblemon\.com\.br|starscobblemon\.com)$ [NC]
RewriteRule ^ https://starspixelmon.com.br%{REQUEST_URI} [L,R=301]
# 2. HTTP -> HTTPS no mesmo endereço (vale também para subdomínios)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── URLs limpas (sem .html) ──────────────────────────────────────────────────────────────
# Cada página é uma pasta com index.html: /como-jogar, /termos, /starians/<id>.
# As regras valem só para o domínio principal (o launcher.starspixelmon.com.br passa por este arquivo também).
# Os 301 olham THE_REQUEST (o que o visitante pediu), para não brigar com a regra interna do passo 4.
DirectorySlash Off

# 3. endereços antigos -> novos (301)
RewriteCond %{HTTP_HOST} ^starspixelmon\.com\.br$ [NC]
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
RewriteRule ^index\.html$ / [L,R=301]

RewriteCond %{HTTP_HOST} ^starspixelmon\.com\.br$ [NC]
RewriteCond %{THE_REQUEST} \s/+(como-jogar|termos)(\.html|/index\.html|/)[\s?]
RewriteRule ^(como-jogar|termos)(\.html|/index\.html|/)$ /$1 [L,R=301]

RewriteCond %{HTTP_HOST} ^starspixelmon\.com\.br$ [NC]
RewriteCond %{THE_REQUEST} \s/+starian-[a-z0-9-]+\.html[\s?]
RewriteRule ^starian-([a-z0-9-]+)\.html$ /starians/$1 [L,R=301]

RewriteCond %{HTTP_HOST} ^starspixelmon\.com\.br$ [NC]
RewriteCond %{THE_REQUEST} \s/+starians/[a-z0-9-]+(/|/index\.html)[\s?]
RewriteRule ^starians/([a-z0-9-]+)(/|/index\.html)$ /starians/$1 [L,R=301]

# /starians sem nome -> Starian Dex na home
RewriteCond %{HTTP_HOST} ^starspixelmon\.com\.br$ [NC]
RewriteRule ^starians/?$ /#starians [L,R=301,NE]

# 4. URL limpa -> arquivo (interno, a barra de endereço não muda)
RewriteCond %{HTTP_HOST} ^starspixelmon\.com\.br$ [NC]
RewriteRule ^(como-jogar|termos|starians/[a-z0-9-]+)$ $1/index.html [L]

# Página de erro
ErrorDocument 404 /404.html

# Tipos e charset corretos (o manifest saía como text/plain)
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .xml .txt .webmanifest
AddType application/manifest+json .webmanifest

# Pastas de manutenção nunca ficam públicas (o pacote de deploy não as envia, isto é só uma garantia)
RedirectMatch 404 ^/(tools|assets|bases|\.git)(/|$)

# Cache: HTML sempre atualizado; CSS/JS/fontes/imagens por 1 ano (o ?v= do build troca a versão)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # o site só existe em HTTPS: o navegador passa a nunca tentar HTTP (1 ano)
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
